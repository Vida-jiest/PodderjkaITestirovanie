<Window x:Class="Задание.CustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Покупатель" Height="450" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <Label Content="ФИО:*" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtFullName"/>
            <Label Content="Телефон:*" FontWeight="Bold" Margin="0,10,0,5"/>
            <TextBox x:Name="txtPhone"/>
            <Label Content="Email:" Margin="0,10,0,5"/>
            <TextBox x:Name="txtEmail"/>
            <Label Content="Адрес:" Margin="0,10,0,5"/>
            <TextBox x:Name="txtAddress"/>
            <Label Content="Город:" Margin="0,10,0,5"/>
            <TextBox x:Name="txtCity"/>
            <Label Content="Дата рождения:" Margin="0,10,0,5"/>
            <DatePicker x:Name="dpBirthDate"/>
            <TextBlock x:Name="lblRequired" Foreground="Red" Margin="0,15,0,0" Text="* - обязательные поля" FontSize="11"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="btnSave" Content="Сохранить" Background="#4CAF50" Foreground="White" Width="120" Click="btnSave_Click"/>
            <Button x:Name="btnCancel" Content="Отмена" Background="#9E9E9E" Foreground="White" Width="120" Click="btnCancel_Click"/>
        </WrapPanel>
    </Grid>
</Window>