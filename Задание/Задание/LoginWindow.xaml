<Window x:Class="Задание.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аптека - Вход" Height="400" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Background="#F0F8FF">
        <Border Background="White" CornerRadius="10" BorderBrush="#007ACC" BorderThickness="2" Width="380" Height="350" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Margin="25">
                <TextBlock Text="💊 АПТЕКА" FontSize="28" FontWeight="Bold" Foreground="#007ACC" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="Вход в систему" FontSize="16" HorizontalAlignment="Center" Foreground="#666" Margin="0,0,0,25"/>
                <TextBlock Text="Логин" Foreground="#333"/>
                <TextBox x:Name="txtLogin"/>
                <TextBlock Text="Пароль" Foreground="#333" Margin="0,10,0,0"/>
                <PasswordBox x:Name="txtPassword"/>
                <Button x:Name="btnLogin" Content="ВОЙТИ" Background="#007ACC" Foreground="White" Click="btnLogin_Click" Margin="0,30,0,0"/>
                <TextBlock x:Name="lblStatus" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="Red" FontSize="12"/>
                <TextBlock Text="Тестовые учётные записи:" FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                <TextBlock Text="admin / admin123" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                <TextBlock Text="zhanna / zhanna123" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>