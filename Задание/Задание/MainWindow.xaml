<Window x:Class="Задание.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аптека - Управление" Height="700" Width="1100" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="AlternatingRowBackground" Value="#F5F5F5"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#007ACC" Padding="10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="💊 АПТЕКА" Foreground="White" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="lblUserInfo" Foreground="White" VerticalAlignment="Center" FontSize="14" Margin="0,0,15,0"/>
                    <Button x:Name="btnLogout" Content="Выйти" Background="White" Foreground="#007ACC" Width="80" Click="btnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="10">
            <!-- Лекарства -->
            <TabItem Header="💊 Лекарства">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F5F5F5" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                        <WrapPanel>
                            <Label Content="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="txtSearchMedicine" Width="200" TextChanged="txtSearchMedicine_TextChanged"/>
                            <Button Content="🔍 Найти" Width="80" Background="#2196F3" Foreground="White" Click="btnSearchMedicine_Click"/>
                            <Button Content="❌ Сброс" Width="80" Click="btnClearSearchMedicine_Click"/>
                            <Separator Width="20" Visibility="Hidden"/>
                            <Button x:Name="btnAddMedicine" Content="➕ Добавить" Background="#4CAF50" Foreground="White" Click="btnAddMedicine_Click"/>
                            <Button x:Name="btnEditMedicine" Content="✏️ Редактировать" Background="#FF9800" Foreground="White" Click="btnEditMedicine_Click"/>
                            <Button x:Name="btnDeleteMedicine" Content="🗑️ Удалить" Background="#F44336" Foreground="White" Click="btnDeleteMedicine_Click"/>
                            <Button x:Name="btnRefreshMedicine" Content="🔄 Обновить" Click="btnRefreshMedicine_Click"/>
                        </WrapPanel>
                    </Border>
                    <DataGrid x:Name="dgMedicines" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID_лекарства}" Width="50"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Название}" Width="180"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding Тип}" Width="90"/>
                            <DataGridTextColumn Header="Вид" Binding="{Binding Вид}" Width="100"/>
                            <DataGridTextColumn Header="Производитель" Binding="{Binding Производитель}" Width="140"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding Цена, StringFormat=N2}" Width="80"/>
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Количество}" Width="70"/>
                            <DataGridTextColumn Header="Срок годности" Binding="{Binding Срок_годности, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                            <DataGridTextColumn Header="Дата поступления" Binding="{Binding Дата_поступления, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Покупатели -->
            <TabItem Header="👥 Покупатели">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F5F5F5" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                        <WrapPanel>
                            <Label Content="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="txtSearchCustomer" Width="200" TextChanged="txtSearchCustomer_TextChanged"/>
                            <Button Content="🔍 Найти" Width="80" Background="#2196F3" Foreground="White" Click="btnSearchCustomer_Click"/>
                            <Button Content="❌ Сброс" Width="80" Click="btnClearSearchCustomer_Click"/>
                            <Separator Width="20" Visibility="Hidden"/>
                            <Button x:Name="btnAddCustomer" Content="➕ Добавить" Background="#4CAF50" Foreground="White" Click="btnAddCustomer_Click"/>
                            <Button x:Name="btnEditCustomer" Content="✏️ Редактировать" Background="#FF9800" Foreground="White" Click="btnEditCustomer_Click"/>
                            <Button x:Name="btnDeleteCustomer" Content="🗑️ Удалить" Background="#F44336" Foreground="White" Click="btnDeleteCustomer_Click"/>
                            <Button x:Name="btnRefreshCustomer" Content="🔄 Обновить" Click="btnRefreshCustomer_Click"/>
                        </WrapPanel>
                    </Border>
                    <DataGrid x:Name="dgCustomers" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID_покупателя}" Width="50"/>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding ФИО}" Width="200"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Телефон}" Width="120"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                            <DataGridTextColumn Header="Адрес" Binding="{Binding Адрес}" Width="200"/>
                            <DataGridTextColumn Header="Город" Binding="{Binding Город}" Width="100"/>
                            <DataGridTextColumn Header="Дата рождения" Binding="{Binding Дата_рождения, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Продажи -->
            <TabItem Header="💰 Продажи">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F5F5F5" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                        <WrapPanel>
                            <Label Content="Период:" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpStartDate" Width="110" Margin="5"/>
                            <Label Content="по" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpEndDate" Width="110" Margin="5"/>
                            <Button Content="📊 Фильтр" Background="#2196F3" Foreground="White" Click="btnFilterSales_Click"/>
                            <Button Content="🔄 Сброс" Click="btnClearFilter_Click"/>
                            <Separator Width="20" Visibility="Hidden"/>
                            <Button x:Name="btnNewSale" Content="➕ Новая продажа" Background="#4CAF50" Foreground="White" Click="btnNewSale_Click"/>
                            <Button x:Name="btnRefreshSales" Content="🔄 Обновить" Click="btnRefreshSales_Click"/>
                        </WrapPanel>
                    </Border>
                    <DataGrid x:Name="dgSales" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID_продажи}" Width="50"/>
                            <DataGridTextColumn Header="Чек" Binding="{Binding Номер_чека}" Width="120"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Дата_продажи, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="130"/>
                            <DataGridTextColumn Header="Лекарство" Binding="{Binding Лекарство}" Width="150"/>
                            <DataGridTextColumn Header="Покупатель" Binding="{Binding Покупатель}" Width="150"/>
                            <DataGridTextColumn Header="Продавец" Binding="{Binding Продавец}" Width="120"/>
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Количество}" Width="60"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding Цена_продажи, StringFormat=N2}" Width="70"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding Сумма, StringFormat=N2}" Width="80"/>
                            <DataGridTextColumn Header="Оплата" Binding="{Binding Способ_оплаты}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Отчеты -->
            <TabItem Header="📊 Отчеты">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F5F5F5" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                        <WrapPanel>
                            <Label Content="Отчет по продажам за период:" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpReportStart" Width="110" Margin="5"/>
                            <Label Content="по" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpReportEnd" Width="110" Margin="5"/>
                            <Button Content="📈 Показать отчет" Background="#4CAF50" Foreground="White" Click="btnShowReport_Click"/>
                        </WrapPanel>
                    </Border>
                    <Border Grid.Row="1" Background="#E3F2FD" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                        <TextBlock x:Name="lblReportTotal" FontSize="14" FontWeight="Bold"/>
                    </Border>
                    <DataGrid x:Name="dgReport" Grid.Row="2" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Дата}" Width="100"/>
                            <DataGridTextColumn Header="Кол-во продаж" Binding="{Binding Количество_продаж}" Width="100"/>
                            <DataGridTextColumn Header="Продано единиц" Binding="{Binding Продано_единиц}" Width="100"/>
                            <DataGridTextColumn Header="Выручка" Binding="{Binding Выручка, StringFormat=N2}" Width="120"/>
                            <DataGridTextColumn Header="Средний чек" Binding="{Binding Средний_чек, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="Уникальные покупатели" Binding="{Binding Уникальные_покупатели}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Статус бар -->
        <Border Grid.Row="2" Background="#E0E0E0" Padding="8">
            <TextBlock x:Name="lblStatus" Text="Готово" FontSize="11"/>
        </Border>
    </Grid>
</Window>