<Window x:Class="Задание.MedicineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лекарство" Height="520" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Label Content="Название:*" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtName"/>

                <Label Content="Тип:" Margin="0,10,0,5"/>
                <ComboBox x:Name="cbType">
                    <ComboBoxItem>Таблетки</ComboBoxItem>
                    <ComboBoxItem>Капсулы</ComboBoxItem>
                    <ComboBoxItem>Сироп</ComboBoxItem>
                    <ComboBoxItem>Мазь</ComboBoxItem>
                    <ComboBoxItem>Раствор</ComboBoxItem>
                    <ComboBoxItem>Аэрозоль</ComboBoxItem>
                </ComboBox>

                <Label Content="Вид:" Margin="0,10,0,5"/>
                <ComboBox x:Name="cbKind">
                    <ComboBoxItem>Без рецепта</ComboBoxItem>
                    <ComboBoxItem>Рецептурный</ComboBoxItem>
                    <ComboBoxItem>Подконтрольный</ComboBoxItem>
                </ComboBox>

                <Label Content="Производитель:" Margin="0,10,0,5"/>
                <TextBox x:Name="txtManufacturer"/>

                <WrapPanel Margin="0,10,0,0">
                    <StackPanel Width="240" Margin="0,0,20,0">
                        <Label Content="Цена:*" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtPrice"/>
                    </StackPanel>
                    <StackPanel Width="240">
                        <Label Content="Количество:*" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtQuantity"/>
                    </StackPanel>
                </WrapPanel>

                <WrapPanel Margin="0,10,0,0">
                    <StackPanel Width="240" Margin="0,0,20,0">
                        <Label Content="Срок годности:" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpExpDate"/>
                    </StackPanel>
                    <StackPanel Width="240">
                        <Label Content="Дата поступления:" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpArrivalDate"/>
                    </StackPanel>
                </WrapPanel>

                <Label Content="Категория:" Margin="0,10,0,5"/>
                <ComboBox x:Name="cbCategory" DisplayMemberPath="Название"/>

                <Label Content="Поставщик:" Margin="0,10,0,5"/>
                <ComboBox x:Name="cbSupplier" DisplayMemberPath="Название"/>

                <TextBlock x:Name="lblRequired" Foreground="Red" Margin="0,15,0,0"
                           Text="* - обязательные поля" FontSize="11"/>
            </StackPanel>
        </ScrollViewer>

        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="btnSave" Content="Сохранить" Background="#4CAF50" Foreground="White" Width="120" Click="btnSave_Click"/>
            <Button x:Name="btnCancel" Content="Отмена" Background="#9E9E9E" Foreground="White" Width="120" Click="btnCancel_Click"/>
        </WrapPanel>
    </Grid>
</Window>